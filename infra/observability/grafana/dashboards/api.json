{
  "uid": "judgegrid-api",
  "title": "JudgeGrid \u2014 Service/API health",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading these development measurements",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Small samples are not capacity/SLO proof. Empty series means no observations. Histogram quantiles combine bucket rates across instances, never average instance quantiles. SSE HTTP time includes stream lifetime. Timestamp estimates include commit/skew; phase intervals may overlap. Trace lookup: Explore \u2192 Tempo \u2192 paste a trace_id from trusted operation logs; follow span links."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status_class)(rate(judgegrid_http_requests_total[2m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Accepted and terminal rates",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome)(rate(judgegrid_operations_total{operation=~\"accepted|terminal\"}[2m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p50",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le,route)(rate(judgegrid_http_duration_seconds_bucket{route!=\"events\"}[2m])))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP p95",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,route)(rate(judgegrid_http_duration_seconds_bucket{route!=\"events\"}[2m])))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP p99",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le,route)(rate(judgegrid_http_duration_seconds_bucket{route!=\"events\"}[2m])))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP sample count",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(judgegrid_http_duration_seconds_count{route!=\"events\"}[2m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Target availability",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"judgegrid-.+\"}",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    }
  ],
  "tags": [
    "JudgeGrid",
    "development"
  ]
}
