{
  "uid": "judgegrid-recovery",
  "title": "JudgeGrid \u2014 Ownership, recovery and SSE",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading these development measurements",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Small samples are not capacity/SLO proof. Empty series means no observations. Histogram quantiles combine bucket rates across instances, never average instance quantiles. SSE HTTP time includes stream lifetime. Timestamp estimates include commit/skew; phase intervals may overlap. Trace lookup: Explore \u2192 Tempo \u2192 paste a trace_id from trusted operation logs; follow span links."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Valid/expired leases",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "judgegrid_state{kind=\"leases\"}",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lease renewals and fences",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome)(rate(judgegrid_operations_total{operation=~\"lease.renew|lease.fail|fence.reject\"}[2m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SSE connections",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "judgegrid_state{kind=\"sse\"}",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconnect/replay/reset/slow",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome)(increase(judgegrid_operations_total{operation=~\"sse.reconnect|sse.replay|sse.reset|sse.slow\"}[5m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Event timestamp to server flush p95",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(judgegrid_duration_seconds_bucket{phase=\"sse.delivery\"}[2m])))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Exporter errors/drops",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome)(rate(judgegrid_operations_total{operation=~\"exporter.export|exporter.drop\"}[2m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Reconciliation outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "judgegrid-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome)(increase(judgegrid_operations_total{operation=~\"reconcile.*\"}[5m]))",
          "legendFormat": "{{phase}} {{operation}} {{outcome}} {{state}} {{route}}"
        }
      ]
    }
  ],
  "tags": [
    "JudgeGrid",
    "development"
  ]
}
